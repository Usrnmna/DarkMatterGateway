root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# Preserve the saved bytes of references covered by the retrieval manifest.
[docs/proflame2/sources/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
